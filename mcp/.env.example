# Turbo Notes AWS MCP — account 615737882760
AWS_ACCOUNT_ID=615737882760
AWS_REGION=us-east-2
AWS_PROFILE=turboai-615737882760
# IAM Identity Center start URL for account 615737882760.
# Find it in the AWS console (IAM Identity Center → Settings) or in the
# "Welcome to AWS IAM Identity Center" invite email; format is
# https://d-XXXXXXXXXX.awsapps.com/start. Used by aws-sso-bootstrap.sh and
# the MCP server's aws_sso_login flow.
AWS_SSO_START_URL=https://d-XXXXXXXXXX.awsapps.com/start
AWS_SSO_REGION=us-east-2

# Bastion SSH (MCP tunnel_* / db_* use SSH, not SSM).
# Private key: ~/turbo-notes-bastion.pem (chmod 600) — NEVER commit.
# Public key is in backend/terraform/bastion.pub (aws_key_pair in Terraform).
# SSM Session Manager is also enabled (AmazonSSMManagedInstanceCore + AL2023 agent)
# for ops: aws ssm start-session --target <bastion_instance_id>
# or AWS-StartPortForwardingSessionToRemoteHost to RDS:5432.
TURBO_SSH_KEY=/home/jhgcc1/turbo-notes-bastion.pem
TURBO_SSH_USER=ec2-user

# Fill from Terraform outputs after apply (see docs/process/06-staging-deploy.md)
# bastion_host → TURBO_STAGING_SSH_HOST; rds_endpoint → TURBO_STAGING_REMOTE_DB_HOST
TURBO_STAGING_SSH_HOST=
TURBO_STAGING_REMOTE_DB_HOST=
TURBO_STAGING_DB_PASSWORD=
TURBO_STAGING_LOCAL_DB_PORT=5435

TURBO_PROD_SSH_HOST=
TURBO_PROD_REMOTE_DB_HOST=
TURBO_PROD_DB_PASSWORD=
TURBO_PROD_LOCAL_DB_PORT=5436

TURBO_LOG_GROUP_PREFIX=/turboai/notes
