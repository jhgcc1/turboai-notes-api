ENVIRONMENT=local
DEBUG=true
SECRET_KEY=change-me-in-production-use-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,api
# Local/docker only — staging/prod ECS sets these from Terraform to THAT
# environment's web CloudFront URL alone (no wildcards, no localhost, no
# cross-env URLs). Example staging: https://d1qdib1mcwro0s.cloudfront.net
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

POSTGRES_DB=turbo_notes
POSTGRES_USER=turbo
POSTGRES_PASSWORD=turbo_dev_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=

# Cookie JWT
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
COOKIE_DOMAIN=

# Observability
# SERVICE_NAME tags every JSON log line so one log group can host many services.
SERVICE_NAME=turboai-notes-api
AWS_REGION=us-east-1
CLOUDWATCH_LOG_GROUP=
# Leave false on ECS: the awslogs driver already ships stdout to CloudWatch and
# enabling watchtower on top of it duplicates every line. See docs/architecture/observability.md
CLOUDWATCH_ENABLED=false

# Frontend URL (for emails / redirects if needed)
FRONTEND_URL=http://localhost:3000
